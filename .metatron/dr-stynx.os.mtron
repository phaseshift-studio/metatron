[-- load instruction sets --]
      import(/m/mach/io);
        import(/m/math);
          import(/m/web);
            import(/m/llm);

[--------------------------------------------]
[-- a transient space for scratchpad objs  --]
[--------------------------------------------]
memspace::[pattern => /usr/#,                                 
           q       => [typeq::[=>],
                       mintq::[=>],
                       docq::[=>],
                       subq::[=>],
                       incrq::[=>]]]@/sys/space/usr;


[-----------------------------------------------------]
[-- local directory to serve as a file system root  --]
[-----------------------------------------------------]
fsspace::[pattern => home:#,
          q       => [subq::[=>]],
          route   => [home: => <~/.metaron/space/fs/home>]
]@/sys/space/fs/home;


[-------------------------------]
[-- openai lm-studio endpoint --]
[-------------------------------]
catalog::[host         => <http://192.168.1.61:1234/v1>,          
          pattern      => lm:#,                         
          name         => openai,                           
          route        => [lm:rest => <http://192.168.1.61:1234/v1/>]
]@/sys/space/ai/lm_studio;

[== model          -> <lm:zai-org/glm-4.7-flash>; ==]

[== home:agent/msg/inbox  -> [,];
home:agent/msg/outbox -> [,]; ==]

print('loading console...\n');
console::[=>]@/usr/ui/console;
[== glances        -> <http://glances.phaseshift.studio> ==]
[--------------------------------------------------]
[-- http server for static pages and mcp servers --]
[--   * pulls files from fsspace                 --] 
[--------------------------------------------------] 
[==httpspace::[host     => <http://localhost:8777>,                                                         
            q        => [mimeq::[=>]],                       
            pattern  => <http://#>,                     
            route    => [/          => home:]
]@/sys/space/web/http; ==]
[==
[--------------------------------------------------]
[-- websocket server for streaming metatron objs --]
[--------------------------------------------------] 
wsspace::[host     => <ws://dr-stynx.phaseshift.studio:8555>,                          
          pattern  => ws://#,                                           
          q        => [subq::[=>]],                          
          route    => [/mtron => mtron_ws] [-- a console/repl via raw websocket text --]                           
]@/sys/space/web/ws;       


[================================]
[==      agent embedding       ==]
[================================]
[==
model          -> <lm:zai-org/glm-4.7-flash>;
glances        -> <http://glances.phaseshift.studio>;
home:agent/msg/inbox  -> [,];
home:agent/msg/outbox -> [,];

[==
[-- check if gpu is idle --]
asleep -> |(asleep?bool{?}<=#{?}(uri::T){
*<0>.mult(</api/4/gpu>).*(_).
  else(throw('glances server down')).
  >-.=?=[gpu_id=>nvidia0].
  -<[proc  => >>proc,
     fan   => >>fan_speed,
     sleep => >>proc.lt(50)].
  >>sleep
});
[-- heartbeat --]
virtual::[code=>asleep(*glances).
                catch("glances server error").
                println("beat: ", _),
          loop=>second::5.0,
          start=>1]@/usr/ai/heartbeat.
          >>state.
          -<|[?=run => println('{{b}}heartbeat{{X}}: {{y}}${_}{{X}}'), 
                  _ => throw('{{r}}thread not started{{X}}')].catch(print(_));

print("\nrunning heartbeat ${*/usr/ai/heartbeat}\n");
==]




