[== boot args ==]
[
 internal        =>
  [ sys          => /sys,
    home         => /usr/dr,
    typer/stages => [inst_dom     => true, 
                     inst_rng     => true,
                     type_ctor    => true,
                     obj_write    => true,
                     code_resolve => false]],
 external      =>
   [ ollama    => <http://ginger.local:11434>,
     memorydb  => <mariadb://ginger.local:3306/dr_memory?createDatabaseIfNotExist=true&user=mtron&password=mtron>,
     knowgraph => <ws://ginger.local:8182/gremlin>,
     localfs   => </home/killswitch/.hermes_clone>]
]
[===============]
print("""
{{r}}PhaseShift Studio Presents{{X}}
{{y}} ___    ____      _____ ______  __ __  ____   __ __ 
|   \  |    \    / ___/|      ||  |  ||    \ |  |  |
|    \ |  D  )  (   \_ |  {{c}}    ||  |  ||  _  ||  |  |
|  D  ||    /    \__  ||_|  |_||  ~  ||  |  ||_   _|
|     ||    \  __/  \ |  |  |  |___, ||  |  ||     |
|     ||  .  \|  \    |  |  |  |   {{m}}  ||  |  ||  |  |
|_____||__|\_||__|\___|  |__|  |____/ |__|__||__|__|
                                    {{y}} a metatron bomb{{X}}                                      
""")
print("{{r}}----{{y}}----{{r}}----\n{{g}}*{{y}}boot/args{{X}}: ",
      *boot/args, 
     "\n{{y}}----{{r}}----{{y}}----{{X}}\n");
[== instruction sets ==]
print("{{y}}loading instruction sets\n{{X}}");
import(/m/mach/io);
import(/m/web);
import(/m/tble);
import(/m/math);
import(/m/llm);
import(/m/grph);
space_root -> <${*boot/args/internal/sys}/space/dr>;
[===================================================================]
[===================================================================]
        [=====================]  
        [======== HOME =======]
        [=====================]   
memspace::[
  pattern => /usr/dr/#,                                 
        q => [mintq::[=>],
               docq::[=>],
               subq::[=>],
              incrq::[=>]]]@</sys/space/usr>;       
fsspace::[
  pattern => localfs:#,
        q => [subq::[=>],
              mimeq::[=>]],
    route => [localfs: => <~/.hermes_clone>]]@</sys/space/fs/dr>;
    
fsspace::[
  pattern => metatronfs:#,
    route => [metatronfs: => <~/software/metatron/.metatron/>]]@</sys/space/fs/metatron>;
    
catalog::[host    => !*<boot/args/external/ollama>,
          pattern => ollama:#,
          name    => ollama,
          route   => [ollama:=><>]]@</sys/space/llm/ollama>;
          
tblespace::[pattern    => drdb:#,
            host       => !*<boot/args/external/memorydb>,
            driver     => <org.mariadb.jdbc.Driver>,
            table      => [llm_memory, llm_message_system, llm_message_user, llm_message_ai, llm_message_tool_result, llm_model, llm_skill, llm_tool],
            q          => [incrq::[=>],subq::[=>]],
            route      => [drdb:=><>]]@/sys/space/tble/dr;
            
 grphspace::[pattern  => g:#,
             host     => !*<boot/args/external/knowgraph>,
             config   => [
                 <clusterConfigurationFile>                 => '/home/killswitch/software/metatron/conf/remote-objects.yaml',
                 <gremlin.remote.remoteConnectionClass>     => <org.apache.tinkerpop.gremlin.driver.remote.DriverRemoteConnection>,
                 <gremlin.remote.remoteTraversalSourceName> => 'g'],
             route    => [g:V => V, g:E => E]]@</sys/space/grph/kg>;

        [======================]  
        [======== AGENT =======]
        [======================]   
*<drdb:llm_memory/1>.else([agent_id=>'drstynx',name=>'general chat', algorithm=>[max=>15]].to(drdb:llm_memory/1));
model::[desc     => "core agent",
        provider => !*<ollama:gemma4:26b/provider>,
        name     => !*<ollama:gemma4:26b/name>,
        feature  => [think    => |/usr/ui/console/pane/0/stream(_), 
                     memory   => !@<drdb:llm_memory/1>,
                     tool     => [!*eval,!*sql.skip(1).take(1)],
                     note     => !@</usr/dr/notes>,
                     skill    => [!*<metatronfs:skills/mtron>.as(skill::T)],
                     response => [to=>print(_)]]]@<dr>;

console::[=>]@/usr/dr/console;