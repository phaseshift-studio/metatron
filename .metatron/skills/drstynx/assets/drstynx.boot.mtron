[== boot args ==]
[
 internal        =>
  [ sys          => /sys,
    agent_home   => /usr/dr,
    user_home    => /usr/marko,
    session_id   => 1,
    typer/stages => [inst_dom     => true, 
                     inst_rng     => true,
                     type_ctor    => true,
                     obj_write    => true,
                     code_resolve => false]],
 external     =>
  [ web       => [ http => <http://localhost:8777>,
                   ws   => <ws://0.0.0.0:8555> ],
    ollama    => <http://ginger.local:11434>,
    knowgraph => <ws://ginger.local:8182/gremlin>,
    session   => <mariadb://localhost:3306/dr_session?createDatabaseIfNotExist=true&user=mtron&password=mtron>,
    localfs   => </home/killswitch/.hermes_clone>],
 header       => """
   ______          _______ __   {{r}}PhaseShift Studio                    
  |   _  \ .----. |   _   |  |_.--.--.-----.--.--.
  |.  |  {{y}} \|   ___|   1___|   _|  |  |     |_   _|
  |.  |    |__||__|____   |____|___  |{{b}}__|__|__.__|
  |:  1    /      |:  1   |    |_____| presents ..      
  |::.. . /       |::.. . |{{g}}       a metatron bomb                       
  `------'        `-------'          
 """
]
[===============]
print(*boot/args/header)
print("{{r}}----{{y}}----{{r}}----\n{{g}}*{{y}}boot/args{{X}}: ",
      *boot/args, 
     "\n{{y}}----{{r}}----{{y}}----{{X}}\n");
[== instruction sets ==]
print("{{y}}loading instruction sets\n{{X}}");
import(/m/mach/io);
import(/m/web);
import(/m/tble);
import(/m/math);
import(/m/llm);
import(/m/grph);
space_root -> <${*boot/args/internal/sys}/space/dr>;
[===================================================================]
[===================================================================]
        [=====================]  
        [======== HOME =======]
        [=====================]   
memspace::[
  pattern => </usr/dr/#>,                                 
        q => [mintq::[=>],
               docq::[=>],
               subq::[=>],
              incrq::[=>]]]@</sys/space/usr/dr>;   

memspace::[
  pattern => </usr/marko/#>,                                 
        q => [mintq::[=>],
               docq::[=>],
               subq::[=>],
              incrq::[=>]]]@</sys/space/usr/marko>;                 
    
        [=====================]  
        [====== FILE SYS =====]
        [=====================]   
    
fsspace::[
  pattern => root:#,
        q => [mimeq::[=>]],
    route => [root: => /usr/bin]]@</sys/space/fs/root>;


fsspace::[
  pattern => localfs:#,
        q => [subq::[=>],
              mimeq::[=>]],
    route => [localfs: => <~/.hermes_clone>]]@</sys/space/fs/dr>;
    
fsspace::[
  pattern => metatronfs:#,
    route => [metatronfs: => <~/software/metatron/.metatron/>]]@</sys/space/fs/metatron>;
    
        [=====================]  
        [======== WEB ========]
        [=====================]   
            
httpspace::[host     => !*<boot/args/external/web/http>,
            pattern  => <http://#>,
            route    => [/ => <>]]@/sys/space/web/http;   
            
wsspace::[host     => !*<boot/args/external/web/ws>,
         pattern  => <ws://#>,
         route    => [/mcp   => mcp_mtron_ws,
                      /mtron => mtron_ws]]@/sys/space/web/ws;    
    
        [=====================]  
        [======== LLM ========]
        [=====================]       
    
catalog::[host    => !*<boot/args/external/ollama>,
          pattern => ollama:#,
          name    => ollama,
          route   => [ollama:=><>]]@</sys/space/llm/ollama>;
          
tblespace::[pattern    => drdb:#,
            host       => !*<boot/args/external/session>,
            driver     => <org.mariadb.jdbc.Driver>,
            q          => [incrq::[=>],subq::[=>]],
            route      => [drdb:=><>]]@/sys/space/tble/dr;
           
 grphspace::[pattern  => g:#,
             host     => !*<boot/args/external/knowgraph>,
             q        => [incrq::[=>],subq::[=>]],
             schema   => noobj, [-- ensures auto discovery --]
             config   => [
               dataset                                    => <org.apache.tinkerpop.gremlin.LoadGraphWith.GraphData.MODERN>,
               <serializer.className>                     => <org.apache.tinkerpop.gremlin.util.ser.GraphBinaryMessageSerializerV1>,
               <serializer.config.ioRegistries>           => [<org.janusgraph.graphdb.tinkerpop.JanusGraphIoRegistry>],
               <gremlin.remote.remoteConnectionClass>     => <org.apache.tinkerpop.gremlin.driver.remote.DriverRemoteConnection>,
               <gremlin.remote.remoteTraversalSourceName> => g],
             route    => [g: => <>]]@</sys/space/grph/kg>;

        [======================]  
        [======== AGENT =======]
        [======================]   

[== if the llm session already exists, continue, else create it ==]    
*<drdb:llm_session/1>.
  else(session::[agent     => !*boot/args/internal/agent_home,
                 user      => !*boot/args/internal/user_home,
                 name      => 'general chat',
                 message   => <drdb:msg/1/+>,
                 algorithm => [max=>15]]==[_=>_].
  to(drdb:llm_session/1));

  
model::[desc     => "the agent dr.stynx is here to be of use in the metatron",
        provider => !*<ollama:gemma4:26b/provider>,
        name     => !*<ollama:gemma4:26b/name>,
        feature  => [think    => /usr/marko/console/pane/0/stream(_), 
                     session  => !@<drdb:llm_session/1>,
                     session/on_user  => _,
                     tool     => [!*eval,!*sql],
                     note     => [,],
                     skill    => [!*<metatronfs:skills/mtron>.as(skill::T)],
                     response => [to=>print(_)]]]@<dr>;

[== user console ==]
console::[header=>!*boot/args/header]@/usr/marko/console;