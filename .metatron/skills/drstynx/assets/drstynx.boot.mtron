[== boot args ==]
[
 internal        =>
  [ sys          => /sys,
    agent_home   => /usr/dr,
    user_home    => /usr/marko,
    session_id   => 1,
    typer/stage  => [inst_dom     => true,
                     inst_rng     => true,
                     type_ctor    => true,
                     obj_write    => true,
                     code_resolve => false]],
 external     =>
  [ web       => [ http => <http://localhost:8777>,
                   ws   => <ws://0.0.0.0:8555> ],
    ollama    => <http://ginger.local:11434>,
    embedding => <http://ginger.local:8025/api/v2>,
    knowgraph => <ws://ginger.local:8182/gremlin>,
    session   => <mariadb://ginger.local:3306/drdb?createDatabaseIfNotExist=true&user=mtron&password=mtron>,
    localfs   => </home/killswitch/.hermes_clone>],
 tracer/stage => [stack=>true],

 header       => """
   ______          _______ __   {{r}}PhaseShift Studio                    
  |   _  \ .----. |   _   |  |_.--.--.-----.--.--.
  |.  |  {{y}} \|   ___|   1___|   _|  |  |     |_   _|
  |.  |    |__||__|____   |____|___  |{{b}}__|__|__.__|
  |:  1    /      |:  1   |    |_____| presents ..      
  |::.. . /       |::.. . |{{g}}       a metatron bomb                       
  `------'        `-------'          
 """
]
[===============]
print(*boot/args/header)
print("{{r}}----{{y}}----{{r}}----\n{{g}}*{{y}}boot/args{{X}}: ",
      *boot/args, 
     "\n{{y}}----{{r}}----{{y}}----{{X}}\n");
[== instruction sets ==]
print("{{y}}loading instruction sets\n{{X}}");
import(/m/mach/io);
import(/m/web);
import(/m/tble);
import(/m/math);
import(/m/llm);
import(/m/grph);
import(/m/vec);
import(/m/iot);
import(/m/mach/ui);
space_root -> <${*boot/args/internal/sys}/space/dr>;
[===================================================================]
[===================================================================]
        [=====================]  
        [======== HOME =======]
        [=====================]   
memspace::[
  pattern => </usr/dr/#>, 
     data => </home/killswitch/.metatron/drstynx/usr_dr.mtron>,                             
     q    => [docq::[=>],
               subq::[=>],
              incrq::[=>]]]@</sys/space/usr/dr>;   

memspace::[
  pattern => </usr/marko/#>,                                 
        q => [mintq::[=>],
               docq::[=>],
               subq::[=>],
              incrq::[=>]]]@</sys/space/usr/marko>;                 
    
        [=====================]  
        [====== FILE SYS =====]
        [=====================]   
    
fsspace::[
  pattern => root:#,
        q => [mimeq::[=>]],
    route => [root: => /usr/bin]]@</sys/space/fs/root>;


fsspace::[
  pattern => localfs:#,
        q => [subq::[=>],
              mimeq::[=>],
              safeq::[=>]],
    route => [localfs: => <~/.hermes_clone>]]@</sys/space/fs/dr>;
    
fsspace::[
  pattern => metatronfs:#,
    route => [metatronfs: => <~/software/metatron/.metatron/>]]@</sys/space/fs/metatron>;
    
        [=====================]  
        [======== WEB ========]
        [=====================]   
            
httpspace::[host     => !*<boot/args/external/web/http>,
            q        => [mimeq::[=>]],
            pattern  => <http://#>,
            route    => [[-- /mcp     => mcp_mtron_http, --]
                         /memory => drdb:llm_message_user/,
                         /       => <>]]@/sys/space/web/http;   
   
*boot/args/external/ollama.mult(api/tags/models).*(_).>-.
  =?=[capabilities=>[embedding]].
  -<[llm     => >>name.as(uri::T),
    protocol => ollama,
    provider => ollama,
    host     => *boot/args/external/ollama].
  as(model::T).
  to(/usr/dr/model/embedding/_?incrq);

            
wsspace::[host     => !*<boot/args/external/web/ws>,
         pattern  => <ws://#>,
         route    => [/mcp   => mcp_mtron_ws,
                      /mtron => mtron_ws]]@/sys/space/web/ws;    
    
mqttspace::[host    => <mqtt://ginger.local:1883>,
            pattern => z2m:#,
            q       => [subq::[=>]],
            route   => [z2m: => z2m/]]@/sys/space/iot/z2m;
            
        [=====================]  
        [======== LLM ========]
        [=====================]       
          
tblespace::[pattern    => drdb:#,
            host       => !*<boot/args/external/session>,
            driver     => <org.mariadb.jdbc.Driver>,
            q          => [incrq::[=>],subq::[=>]],
            route      => [drdb:embedding/abc => v:abc,
                           drdb:              => <>]]@/sys/space/tble/dr;
            
vecspace::[pattern     => v:#,
           host        => !*<boot/args/external/embedding>,
           q           => [incrq::[=>],embedq::[=>]],
           driver      => <studio.phaseshift.metatron.isa.vec.space.ChromaV2Client>,
           route       => [v: => <>],
           config      => [embed => [
 [------------------------------------^--]
 abc => inst?lst[real]<=#{?}(doc=>#::T){ */usr/dr/model/embedding/+.=?=[llm=>embeddinggemma:latest].embed(*doc)}
 [------------------------------------^--]                                  
                          ]]]@/sys/space/vec/embed;

grphspace::[pattern  => h:#,
             host     => !*<boot/args/external/knowgraph>,
             q        => [incrq::[=>],subq::[=>]],
             schema   => noobj,
             config   => [
               dataset                                    => <org.apache.tinkerpop.gremlin.LoadGraphWith.GraphData.CREW>,
               <serializer.className>                     => <org.apache.tinkerpop.gremlin.util.ser.GraphBinaryMessageSerializerV1>,
               <serializer.config.ioRegistries>           => [<org.janusgraph.graphdb.tinkerpop.JanusGraphIoRegistry>],
               <gremlin.remote.remoteConnectionClass>     => <org.apache.tinkerpop.gremlin.driver.remote.DriverRemoteConnection>,
               <gremlin.remote.remoteTraversalSourceName> => g],
             route    => [h: => <>]]@</sys/space/grph/kg>;

 grphspace::[pattern  => g:#,
             q        => [incrq::[=>],subq::[=>]],
             schema   => noobj,
             config   => [
               dataset         => <org.apache.tinkerpop.gremlin.LoadGraphWith.GraphData.MODERN>,
               <gremlin.graph> => <org.apache.tinkerpop.gremlin.tinkergraph.structure.TinkerGraph>],
             route    => [g:   => <>]]@</sys/space/grph/local>;
        [======================]
        [======== AGENT =======]
        [======================]

[== if the llm session already exists, continue, else create it ==]    
</usr/dr/llm_session>.mult(print('\n what session number?: ').stdin().as(uri::T)).to(session_vid);

*(*session_vid).
  else(session::[agent     => !*boot/args/internal/agent_home,
                 user      => !*boot/args/internal/user_home,
                 name      => 'general chat',
                 algorithm => [name=><token_window>, max=>100000]]==[_=>_].to(*session_vid));
[-- token_window --]
codegraph -> mcp_client::[command=>[</home/killswitch/.local/bin/codegraph>,'serve', '--mcp']];
agent::[name     => 'dr.stynx',
        desc     => 'the agent dr.stynx is here to be of use in the metatron',
        feature  => [chat_feature::[model    => model::[provider => ollama,
                                                        protocol => ollama,
                                                        host     => <http://ginger.local:11434>,
                                                        llm      => <gemma4:26b>],
                                    response => [to => print(_)]],
                     think_feature::[think=>[to=>print(_)]],
                     loop_feature::[max_loop=>100],                       [-- \          --]
                     ledger_feature::[ledger=>/usr/dr/ledger],            [--  | skills  --]
                     skill_feature::[skill=>[<metatronfs:skills/mtron>]], [-- /          --]
                     session_feature::[session => !*session_vid],
                     concept_feature::[base => /usr/dr/concept],
                     system_feature::[=>],
                     audit_feature::[=>],
                     tool_feature::[tool=>[
                                    !*eval,
                                    !*sql,
                                    !*codegraph
                                    [-- mcp_client::[host=><http://localhost:8777/mcp>] --]]]]]@<dr>; 

[== user console ==]
console::[agent=>dr,header=>!*boot/args/header]@/usr/marko/console;

[==
on_prompt => inst(chat=>user::T) {          

}
==]