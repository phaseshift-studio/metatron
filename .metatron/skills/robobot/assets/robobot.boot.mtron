[== boot args ==]
[
 internal        =>
  [ sys          => /sys,
    agent_home   => /usr/dr,
    user_home    => /usr/marko,
    session_id   => 1,
    typer/stages => [inst_dom     => true, 
                     inst_rng     => true,
                     type_ctor    => true,
                     obj_write    => true,
                     code_resolve => false]],
 external     =>
  [ web       => [ http => <http://localhost:8777>,
                   ws   => <ws://0.0.0.0:8555> ],
    mqtt      => [ broker => <mqtt://ginger.local:1883> ],
    ollama    => <http://ginger.local:11434>,
    session   => <mariadb://localhost:3306/dr_sessions?createDatabaseIfNotExist=true&user=mtron&password=mtron>,
    localfs   => </home/killswitch/.hermes_clone>],
 header       => """
            __          __          __   
.----.-----|  PhaseShift  |presents|  |_ 
|   _|  _  |  _  |  _  |  _  |  _  |   _|
|__| |_____|_____|_____|a metatron bomb|                                                                 
"""
]
[===============]

import(/m/iot);

        [=====================]  
        [======== HOME =======]
        [=====================]   
memspace::[pattern => /usr/marko/#,                              
           q       => [docq::[=>],subq::[=>],incrq::[=>]]]@/sys/space/usr;    
[-- !(*<boot/args/internal/user_home> * <#>) --]

mqttspace::[pattern    => <z2m:#>,
            q          => [subq::[=>],docq::[=>]],
            host       => <mqtt://ginger.local:1883>,
            route      => [<z2m:>=><z2m/>]]@/sys/space/mqtt/z2m;

console::[header=>!*boot/args/header]@/usr/marko/ui/console;