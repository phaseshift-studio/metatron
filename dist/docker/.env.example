# =============================================================================
#  metatron — deployment configuration
#  Copy to `.env` and edit; docker compose reads it automatically:
#      cp .env.example .env
#  Every value below is the default — change only what you want to override.
#
#  THREE kinds of knob, and they are NOT interchangeable:
#    1. HOST-SIDE  the `$VAR`s here.  Resolved by compose before anything is
#       created; they drive ports, mounts, limits, and the boot-args string.
#    2. CONTAINER-SIDE  the service's `environment:` block in compose.yaml
#       (JVM options, TZ, ...) — the JVM reads some of these itself.
#    3. BOOT ARGS  the mtron rec (the container command), assembled from the
#       vars below.  This is where the VM itself is configured; the boot file
#       (METATRON_BOOT) applies its own `.else()` default to every key.
#
#  ONE RULE: a deployment-varying value must be read by the boot file from
#  `boot/args` (`.else(<default>)`).  If a boot file hardcodes it in its own
#  header, the header wins and the value set here is silently ignored.
#  Full reference + the commented-out alternatives (build-from-checkout,
#  read-only rootfs, bind state, DNS, ...): dist/docker/README.md → "Compose".
# =============================================================================

# ---- image & boot ----------------------------------------------------------
METATRON_IMAGE=ghcr.io/phaseshift-studio/metatron:latest
# boot profile: a shipped one (boot/*.mtron), a bare path, file:///path, or an http(s):// URL (fetched at boot)
METATRON_BOOT=boot/docker.boot.mtron
METATRON_USER=avatar
METATRON_LOG=info
METATRON_CONSOLE=false
METATRON_DATA=/home/metatron

# ---- network & ports -------------------------------------------------------
# One variable drives host AND container side (and the boot-args URIs and the
# healthcheck), so the four cannot drift apart.
METATRON_BIND_IP=0.0.0.0
METATRON_WS_PORT=8555
METATRON_HTTP_PORT=8777
METATRON_HOSTNAME=metatron
METATRON_CONTAINER=metatron
METATRON_NETWORK=netatron
COMPOSE_PROJECT_NAME=metatron

# ---- state ----------------------------------------------------------------
METATRON_STATE_VOLUME=metatron-state

# ---- docker socket (dckrspace) --------------------------------------------
# The host docker group, so the non-root VM (uid 10001) can drive the daemon:
#   export METATRON_DOCKER_GID=$(stat -c '%g' /var/run/docker.sock)
METATRON_DOCKER_GID=0

# ---- resources -------------------------------------------------------------
METATRON_CPUS=2.0
METATRON_MEMORY=2g
METATRON_MEMORY_RESERVATION=256m
# The java launcher reads this itself; heap = 75% of the memory limit above.
METATRON_JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError"
METATRON_TZ=UTC
METATRON_RESTART=unless-stopped
METATRON_INIT=true
METATRON_STOP_GRACE_PERIOD=30s

# ---- healthcheck -----------------------------------------------------------
METATRON_HEALTH_INTERVAL=30s
METATRON_HEALTH_TIMEOUT=5s
METATRON_HEALTH_RETRIES=3
METATRON_HEALTH_START_PERIOD=20s

# ---- logging ---------------------------------------------------------------
METATRON_LOG_DRIVER=json-file
METATRON_LOG_MAX_SIZE=10m
METATRON_LOG_MAX_FILE=3

# ---- advanced: type-checker & tracer stages (fold into the boot-args rec) ---
# NOTE: the default boot (docker.boot.mtron) does not read these keys; whether a
# custom profile honours them is up to that profile's own boot/args reads.
METATRON_TYPER_INST_DOM=true
METATRON_TYPER_INST_RNG=true
METATRON_TYPER_TYPE_PRED=true
METATRON_TYPER_OBJ_WRITE=true
METATRON_TYPER_CODE_RESOLVE=false
METATRON_TRACER_MTRON_STACK=false
METATRON_TRACER_JAVA_STACK=false
