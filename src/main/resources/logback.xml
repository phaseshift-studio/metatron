<configuration>
    <variable name="ROOT_LEVEL" value="TRACE"/>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>${ROOT_LEVEL}</level>
        </filter>
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="studio.phaseshift.metatron.isa.mach.type.ui.graphitty.GraphittyLogger"/>
        </encoder>
    </appender>
    <root level="${ROOT_LEVEL}">
        <appender-ref ref="STDOUT"/>
    </root>
    <logger name="cch.qos.logback" level="WARN">
        <appender-ref ref="STDOUT"/>
    </logger>
    <logger name="java.net.http" level="WARN"/>
    <logger name="org.mongodb.driver" level="WARN"/>
</configuration>