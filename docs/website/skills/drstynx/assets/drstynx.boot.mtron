                                                                                                         div(*</usr/dr/model/context>.
                                                                                                         as(real::T)) * 100.0.as(int::T).print(_).as(str::T))]]],
                                                                         data=>-<[
                                                                          sys=>>>system, 
                                                                          ai=>>>ai, 
                                                                          user=>>>user, 
                                                                          tool=>>>tool_result,
                                                                          <>  =>*</usr/dr/model/context>.-(*tok>>.sum()).else(0).print('here:',_)]]@<token_widget>.display() } ==]