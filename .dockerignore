# Build context whitelist — the image only needs the uber-jar, boot/conf and the skills docs.
# The jar is taken straight from `mvn package` output (target/), so there is no staging copy
# in the repo root:  bin/metatron-docker image  packages it first, then builds.
*
!target/
target/*
!target/metatron-*-jar-with-dependencies.jar
!boot/
!boot/**
!conf/
!conf/**
!dist/
!dist/docker/
!dist/docker/Dockerfile
!docs/
!docs/website/
!docs/website/skills/
!docs/website/skills/mtron/
!docs/website/skills/metatron/
!bin/
!bin/wsplus
