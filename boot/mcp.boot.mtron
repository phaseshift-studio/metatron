import(/m/mach/io);
import(/m/mach/ui,ui);
import(/m/web,web);
import(/m/llm);
import(/m/math,math);
[-- the checkout, so a tool can read and write source --]
fsspace::[pattern => mfs:#, q => [mimeq::[=>],lineq::[=>]], route => [mfs: => <.>]]@/sys/space/fs/metatron;
memspace::[pattern => </usr/#>, q => [docq::[=>],subq::[=>],incrq::[=>]]]@/sys/space/usr;
[-- the server: a selection over instructions; the host below names it --]
mcp_server::[tool => [!*eval]]@/sys/space/mcp/basic_server;
[-- the host: that server served on the process's stdin/stdout, which is the whole session --]
mcp_stdio::[host => !*</sys/space/mcp/basic_server>]@/sys/io/mcp/stdio;
