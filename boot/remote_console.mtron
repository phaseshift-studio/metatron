import(/m/mach/io);
import(/m/web);

memspace::[pattern=>/usr/#]@/sys/space/usr;
/usr/web/ws ->(*<boot/args/host/ws>.-<[host=><${_}/mtron>].as(wsclient::T));
console::[=>]@/usr/ui/console;
*/m/web/helper.remote_console();
