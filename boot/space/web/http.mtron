[-- http_server — the http presence of this machine: the mcp route and this directory.  Binds 0.0.0.0 for the container. --]
|inst?http_server<=uri() {
  -<([origin  => _,
      route   => [/mcp       => mcp_mtron,
                  /highlight => fs:docs/website/highlight,
                  /css       => fs:docs/website/css,
                  /js        => fs:docs/website/js,
                  /          => fs:boot/space/web]]).as(http_server::T) }
