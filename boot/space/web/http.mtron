[-- httpspace — http server with the mcp route.  Binds 0.0.0.0 for the container. --]
||inst?httspace<=uri() { 
  -<([host    => _,
      q       => [mimeq::[=>]],
      pattern => http://#,
      route   => [/mcp   => mcp_mtron,
                  /      => fs:boot/space/web]]@/sys/space/web/http).as(httpspace::T) }
