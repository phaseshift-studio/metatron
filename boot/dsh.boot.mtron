    color: #58a6ff;
}
footer {
    flex-shrink: 0;
}
""".map(html::"""
<html>
  <head>
   <title>dsh metatron</title>
   <style>${_}</style>
  </head>
  <body>
    {{{*help_message>>=['\{\{.}}' => '']}}}
   </body>
<html>
"""@help_html);
[===================================================================]
[== 5. the server: write endpoint, query endpoint, space, files     ==]
[===================================================================]
http_server::[origin => <http://0.0.0.0:8777>,
              route  => [/dsh  => mcp_dsh_mirror,
                         /mcp  => mcp_mtron,
                         /usr  => /usr,
                         /fs   => fs:,
                         /help => help_html,
                         /     => /fs ]]@/sys/space/web/http;

[===================================================================]
[== 6. a console, so a bad boot is debuggable instead of silent      ==]
[===================================================================]
[== the interactive console on this process's stdin/stdout:           ==]
[== pass console=>true to boot args to keep it, else boot prints and  ==]
[== moves on. Mirrors docker.boot.mtron's console line exactly.       ==]
*<boot/args/console>.?=true.
  else(print('{{y}}console: off{{X}} — add {{b}}console=><true>{{X}} to boot args for a REPL\n')).
       -<[[=>]@/sys/console.as(console::T)];

[== the ws presence — the fastest way to poke the ether, no MCP       ==]
[== handshake, no session id, one shot:                               ==]
[==                                                                    ==]
[==   bin/wsplus -e '*/usr/dsh/event/+' ws://booger.local:8555/mtron  ==]
[==   bin/wsplus -e '*/sys/space/usr/dsh/schema' …                   ==]
[==   bin/wsplus -e '[kind=>t].to(/usr/dsh/event/_?incrq)' …         ==]
[==                                                                    ==]
ws_server::[origin => <ws://0.0.0.0:8555>,
            route  => [/mtron => mtron_ws,
                       /dsh   => mcp_dsh_mirror]]@/sys/space/web/ws;

print(*help_message)
