[== a peer's own boot ==]
import(/m/sys);
import(/m/math,math);
import(/m/math/cat,cat);
import(/m/web,web);
[== all peer to discover peers ==]
mdns_discovery::[=>];
fsspace::[pattern=>fs:#,
          route  => [fs: => <~>]]@~/memory/space/fs;
harvest?rec<=int{*}(uri{?}::T){
  spawn?uri<=int(<//localhost:${_ + 1111}/${_}>,<//${_}>,*0).
    -<[host=>_].as(ws_client::T).barrier()>>host.>-[,].as(rec::T)}@harvest;

