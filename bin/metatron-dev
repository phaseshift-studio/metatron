#!/bin/sh
# bin/metatron-dev — developer entry point for the edit-build-run loop.
# Builds the uber-jar (offline, skipping tests), then delegates to the same
# java invocation as bin/metatron.  Run from anywhere — the script resolves
# its own location to find the project root.
#
# Usage:
#   metatron                                    # boots from boot/boot.mtron
#   metatron "[boot=><boot/boot.mtron>,log=>info]"
#   metatron --headless "[boot=><boot/boot.mtron>,log=>info]"

set -e

# Resolve symlinks to the real script path, then cd to the project root
cd "$(dirname "$(readlink -f "$0")")/.."

# Source ANSI color definitions
. "$(dirname "$(readlink -f "$0")")/color.sh"

# Dev default: no args → boot from boot/boot.mtron at info log level
if [ $# -eq 0 ]; then
    set -- "[boot=><boot/boot.mtron>,log=>info]"
fi

# Required JVM flags (same as bin/metatron) — exec:java reuses Maven's JVM
export MAVEN_OPTS="--add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED --enable-native-access=ALL-UNNAMED"

# Compile and run via Maven classpath (fast — no uber-jar assembly)
# The [✓] prints after metatron exits, confirming clean shutdown
printf "  ${GREEN}compiling metatron${NC} ... "
mvn compile exec:java -o -q -Dexec.args="$*"
printf "${LB}${BOLDGREEN}✓${RB}\n"
