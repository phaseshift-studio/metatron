#!/bin/sh
# run the metatron container image against the local docker daemon.
# dckrspace::T boots pull their infra (sqlite, postgres, janusgraph, ...) via the
# host docker socket, which is why it is mounted here.
set -e

IMAGE="${METATRON_IMAGE:-ghcr.io/phaseshift-studio/metatron:main}"

if [ $# -eq 0 ]; then
  set -- "[boot=><boot/docker.boot.mtron>,log=>info]"
fi

echo "  metatron w/
      ░█▀▄░█▀█░█▀▀░█░█░█▀▀░█▀▄
      ░█░█░█░█░█░░░█▀▄░█▀▀░█▀▄
      ░▀▀░░▀▀▀░▀▀▀░▀░▀░▀▀▀░▀░▀"
echo "metatron-docker: $*"
exec docker run --rm -it \
  -p 8555:8555 \
  -p 8777:8777 \
  -v /var/run/docker.sock:/var/run/docker.sock \
  --group-add "$(stat -c '%g' /var/run/docker.sock)" \
  "$IMAGE" "$@"
