#!/usr/bin/env python3
# wsplus — a basic mtron console for a headless metatron ws:// server.
# Connects to the server's /mtron endpoint and presents a REPL:
#
#   mtron> 1 + 2
#   ==>3
#
# Persistent connection (session state carries across lines), readline history
# + arrow keys when run on a TTY.
import asyncio
import sys

""" ANSI color codes """
# ─── Foreground ───────────────────────────────────────────
BLACK = '\u001b[0;30m'
RED = '\u001b[0;31m'
GREEN = '\u001b[0;32m'
BROWN = '\u001b[0;33m'
BLUE = '\u001b[0;34m'
MAGENTA = '\u001b[0;35m'
CYAN = '\u001b[0;36m'
LIGHT_GRAY = '\u001b[0;37m'
DARK_GRAY = '\u001b[1;30m'
LIGHT_RED = '\u001b[1;31m'
LIGHT_GREEN = '\u001b[1;32m'
YELLOW = '\u001b[1;33m'
LIGHT_BLUE = '\u001b[1;34m'
LIGHT_PURPLE = '\u001b[1;35m'
WHITE = '\u001b[1;37m'

# ─── Background ───────────────────────────────────────────
BG_BLACK = '\u001b[40m'
BG_RED = '\u001b[41m'
BG_GREEN = '\u001b[42m'
BG_BROWN = '\u001b[43m'
BG_BLUE = '\u001b[44m'
BG_MAGENTA = '\u001b[45m'
BG_CYAN = '\u001b[46m'
BG_LIGHT_GRAY = '\u001b[47m'
BG_DARK_GRAY = '\u001b[100m'
BG_LIGHT_RED = '\u001b[101m'
BG_LIGHT_GREEN = '\u001b[102m'
BG_YELLOW = '\u001b[103m'
BG_LIGHT_BLUE = '\u001b[104m'
BG_LIGHT_PURPLE = '\u001b[105m'
BG_WHITE = '\u001b[107m'
BG_RESET = '\u001b[49m'  # reset background only
FG_RESET = '\u001b[39m'  # reset foreground only (bonus)
# ─── Styles ───────────────────────────────────────────────
BOLD = '\u001b[1m'
DIM = '\u001b[2m'
ITALIC = '\u001b[3m'
UNDERLINE = '\u001b[4m'
BLINK = '\u001b[5m'
REVERSE = '\u001b[7m'
HIDDEN = '\u001b[8m'
STRIKETHROUGH = '\u001b[9m'

NC = '\u001b[0m'

try:
    import websockets
except ImportError:
    print("wsplus requires the 'websockets' package: pip install websockets")
    sys.exit(1)

history = None
try:
    import readline  # up-arrow history + line editing for input()
    import atexit
    import os

    history = os.path.join(os.path.expanduser("~"), ".wsplus_history")
    atexit.register(readline.write_history_file, history)
    readline.set_history_length(1000)
    readline.read_history_file(history)
except ImportError:
    print("no readline capability")
    pass
except FileNotFoundError:
    try:
        readline.write_history_file(history)
    except Error:
        pass
    pass

BANNER = rf"""{BLUE}                _        _                   
 _ __ ___   ___| |_ __ _| |_ _ __ ___  _ __  
| '_ ` _ \ / _ \ {CYAN}__/ _` | __| '__/ _ \| '_ \ 
| | | | | |  __/ || (_| | |_| | | (_) | | | |
|_|_|_| |_|\___|\__\__,_|\__|_|{WHITE}  \___/|_| |_|
\ \ /\ / / __|{CYAN}{RED} _|{BG_RED} {BG_RESET}|_    {BLACK}PhaseShift Studio              
{CYAN} \ V  V /\__ \{RED}|{BG_RED}_   _{BG_RESET}|                 
{CYAN}  \_/\_/ {BLUE}/___/{RED}  |{BG_RED}_{BG_RESET}|                                         
{DARK_GRAY} a web socket mtron console ({BROWN}ctrl-c {DARK_GRAY}to {BROWN}:quit{DARK_GRAY}){NC}"""


async def repl(url):
    async with websockets.connect(url) as ws:
        while True:
            try:
                line = input(MAGENTA + "mtron" + GREEN + "> " + NC)
            except (EOFError, KeyboardInterrupt):
                print()
                return
            if not line.strip():
                continue
            if line.strip() in (":quit", ":exit"):
                print()
                return
            await ws.send(line)
            try:
                result = await asyncio.wait_for(ws.recv(), 30)
                text = result.decode() if isinstance(result, bytes) else str(result)
                if not text.strip() or text.strip() == "noobj":  # silent for empty/noobj results
                    continue
                print(GREEN + "==>" + NC + text.replace("\n", "\n   "))
            except asyncio.TimeoutError:
                print(RED + "==>ERROR: " + NC + "timed out")


def main():
    url = sys.argv[1] if len(sys.argv) > 1 else "ws://localhost:8555/mtron"
    print(BANNER)
    try:
        asyncio.run(repl(url))
    except KeyboardInterrupt:
        print()
    except Exception as e:
        print(RED + "==>ERROR: " + NC + f"{e}")
        sys.exit(1)


if __name__ == "__main__":
    main()
