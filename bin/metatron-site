#!/bin/bash
#
# bin/metatron-site — build selected website stages via `./mvnw site`, or a
# single document via its runner.
#
# Two modes:
#
#   1. STAGE mode — name stages; every other stage is skipped. The wsplus
#      bundling (skipSiteScripts) is a build-product sync, not a doc stage, so
#      it is always skipped. `mvn site` compiles first, so JDK 25 must be on PATH.
#
#        bin/metatron-site all                                # == the five stages
#        bin/metatron-site markdown instset asciidoc header   # every page, no casts
#        bin/metatron-site asciinema                          # only the casts
#        bin/metatron-site asciinema markdown                 # casts, then pages
#
#      The casts build before the markdown pass in one `mvn site`, because a page
#      that embeds a recording reads that cast's header for its terminal size —
#      name both when a cast's cols/rows changed.
#
#   2. FILE mode — give a document path and the runner is chosen by extension,
#      and only that file is built (the jar is rebuilt first when stale):
#
#        bin/metatron-site docs/asciinema/mini-tutorials.md    # casts only, no page
#        bin/metatron-site docs/website/adoc/space.adoc        # AsciiDocRunner
#        bin/metatron-site docs/skills/mtron/SKILL.md          # MarkdownRunner
#        bin/metatron-site docs/articles/*.md                  # -> docs/website/articles
#
#      .java names the instset reference, which has no single-file mode: it runs
#      the whole `instset` stage instead.
#
#   DRY_RUN=1 bin/metatron-site docs/website/adoc/space.adoc   # print, don't run

set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$DIR"

MARKDOWN_RUNNER="studio.phaseshift.metatron.docs.MarkdownRunner"
ASCIIDOC_RUNNER="studio.phaseshift.metatron.docs.AsciiDocRunner"

# the JVM flags the site runners need — the same set the pom's exec executions
# pass, kept here so a single-document build matches a full `mvn site` run.
JVM_FLAGS=(
    --enable-native-access=ALL-UNNAMED
    --add-modules jdk.incubator.vector
    --add-opens java.base/java.lang=ALL-UNNAMED
    --add-opens java.base/java.lang.invoke=ALL-UNNAMED
    --add-opens java.base/java.lang.reflect=ALL-UNNAMED
    --add-opens java.base/java.util=ALL-UNNAMED
    --add-opens java.base/java.util.concurrent.atomic=ALL-UNNAMED
    --add-opens java.base/java.io=ALL-UNNAMED
    --add-opens java.base/java.nio=ALL-UNNAMED
    --add-opens java.base/java.net=ALL-UNNAMED
    --add-opens java.base/sun.nio.cs=ALL-UNNAMED
)

usage() {
    cat <<'EOF'
usage: bin/metatron-site <stage ... | file ...>

stages (build only what you name; the rest is skipped):
  markdown   the skill references + theory articles   (MarkdownRunner)
  instset    the instruction-set API reference        (InstSetDocGenerator)
  asciidoc   the adoc pages                           (AsciiDocRunner)
  header     the navigation dropdowns                 (HeaderGenerator)
  asciinema  the terminal recordings in docs/asciinema (MarkdownRunner --cast-out)
  all        == markdown instset asciidoc header asciinema

files (the runner is chosen by extension; only that file is built):
  *.md       MarkdownRunner (docs/asciinema/*.md emit recordings only, no page)
  *.adoc     AsciiDocRunner
  *.java     the whole `instset` stage (no single-file mode)

what a single file builds:
  docs/articles/<name>.md   evaluates its ```mtron_pre blocks, writes the processed
                            markdown into docs/website/articles/, THEN renders the html
                            page for THAT ONE file (--only <name>.md); the other
                            articles are left untouched.
  docs/skills/**/SKILL.md   evaluates the blocks and writes the processed markdown
                            copy; no page (the `markdown` stage renders skill html).
  docs/asciinema/*.md       evaluates the tagged blocks and emits the .cast only.
  docs/website/adoc/*.adoc  AsciiDocRunner -> docs/website.

examples:
  # one theory article: evaluate its mtron_pre blocks AND re-render its own page
  bin/metatron-site docs/articles/ring-theoretic-distributed-computing.md

  # one skill reference (markdown copy only; no page)
  bin/metatron-site docs/skills/mtron/SKILL.md

  # one adoc page
  bin/metatron-site docs/website/adoc/space.adoc

  # a cast-only source: evaluate + emit the recording, no page
  bin/metatron-site docs/asciinema/mini-tutorials.md

  # stages, in dependency order
  bin/metatron-site markdown instset asciidoc header
  bin/metatron-site all

  # inspect without running, or run an existing jar without rebuilding it
  DRY_RUN=1  bin/metatron-site docs/articles/ring-theoretic-distributed-computing.md
  NO_BUILD=1 bin/metatron-site docs/articles/ring-theoretic-distributed-computing.md

about the jar (why you sometimes see a "full build" first):
  the runner is this checkout's uber-jar in target/. It is rebuilt with
  `./mvnw -q -DskipTests package` when it is missing OR older than anything under
  src/ or pom.xml. So a doc edit never triggers it; a java edit does, once, until
  the jar is rebuilt. NO_BUILD=1 skips the rebuild and uses the jar as-is.
EOF
}

# the jar is the runner's classpath; rebuild it when missing or older than a
# source file, so a single-document build never evaluates against old code.
ensure_jar() {
    local jar newer
    # a dry run must not build anything
    if [[ "${DRY_RUN:-0}" = "1" ]]; then
        echo "target/metatron-<version>-jar-with-dependencies.jar"
        return 0
    fi
    jar="$(ls -1 target/metatron-*-jar-with-dependencies.jar 2>/dev/null | head -1 || true)"
    if [[ -z "$jar" ]]; then
        echo "==> no uber-jar in target/ — mvn package (skip tests)" >&2
        ./mvnw -q -DskipTests package >&2
        jar="$(ls -1 target/metatron-*-jar-with-dependencies.jar | head -1)"
        echo "$jar"
        return 0
    fi
    newer="$(find src pom.xml -type f -newer "$jar" 2>/dev/null | head -n 3 || true)"
    if [[ -n "$newer" ]]; then
        if [[ "${NO_BUILD:-0}" = "1" ]]; then
            # the caller knows the source change cannot affect this doc run
            { echo "==> source is newer than the jar; using it anyway (NO_BUILD=1):"
              printf '%s\n' "$newer" | sed 's/^/      /'; } >&2
        else
            # say WHY, so a "full build" before a doc run is never a mystery
            { echo "==> jar is older than source — mvn package (skip tests), because:"
              printf '%s\n' "$newer" | sed 's/^/      /'
              echo "      (NO_BUILD=1 runs the existing jar anyway)"; } >&2
            ./mvnw -q -DskipTests package >&2
            jar="$(ls -1 target/metatron-*-jar-with-dependencies.jar | head -1)"
        fi
    fi
    echo "$jar"
}

# where a single markdown file's output belongs — mirrors bin/metatron-docker
# build docs, so `--html` finds the right container from the output path.
markdown_out_dir() {
    case "$1" in
        docs/skills/*.md)
            local rel="${1#docs/skills/}" sub
            case "$rel" in
                */*) sub="${rel%/*}" ;;
                *)   sub="" ;;
            esac
            echo ".metatron/skills${sub:+/$sub}"
            ;;
        docs/articles/*.md) echo "docs/website/articles" ;;
        *) echo "_probe" ;;
    esac
}

run_file() {
    local f="$1" out jar
    # set only by the article branch: a second, VM-free pass that turns the processed
    # .md copies in the articles container into .html siblings
    local html_cmd=()
    case "$f" in
        docs/asciinema/*.md)
            # a CAST-ONLY source: evaluate the tagged blocks, emit the recordings,
            # render no page — out is just scratch space
            jar="$(ensure_jar)"
            echo "==> casts: $f -> docs/website/asciinema"
            local cmd=(java "${JVM_FLAGS[@]}" -cp "$jar" "$MARKDOWN_RUNNER" "$f"
                       -o target/temp/casts --cast-out docs/website/asciinema --no-page)
            ;;
        *.md)
            out="$(markdown_out_dir "$f")"
            jar="$(ensure_jar)"
            echo "==> markdown: $f -> $out"
            local cmd=(java "${JVM_FLAGS[@]}" -cp "$jar" "$MARKDOWN_RUNNER" "$f" -o "$out")
            # An article is a PAGE as well as a set of code samples: after the mtron_pre
            # pass writes the processed .md copy into the articles container, render that
            # container to .html with the same invocation the pom's run-article-runner
            # uses (MarkdownRunner --html docs/articles -o docs/website/articles; the html
            # pass collects no skill docs, so it needs no VM -- it just renders the
            # frontmatter .md files already in the container). Without this, a single-file
            # article build left the page unrendered and only the site-wide build produced
            # the .html.
            case "$f" in
                docs/articles/*.md)
                    echo "==> article html: docs/website/articles ($(basename "$f") only)"
                    html_cmd=(java "${JVM_FLAGS[@]}" -cp "$jar" "$MARKDOWN_RUNNER"
                              --html docs/articles -o docs/website/articles
                              --only "$(basename "$f")")
                    ;;
            esac
            ;;
        *.adoc)
            jar="$(ensure_jar)"
            echo "==> asciidoc: $f -> docs/website"
            # the adoc pass takes the shared prefix and renders html into the site
            local cmd=(java "${JVM_FLAGS[@]}" -cp "$jar" "$ASCIIDOC_RUNNER" "$f"
                       -p docs/python/prefix.adoc -o target/temp --html docs/website)
            ;;
        *)
            echo "bin/metatron-site: unsupported file type '$f'" >&2
            usage >&2
            exit 2
            ;;
    esac
    if [[ "${DRY_RUN:-0}" = "1" ]]; then
        echo "==> run:   ${cmd[*]}"
        if [[ ${#html_cmd[@]} -gt 0 ]]; then echo "==> run:   ${html_cmd[*]}"; fi
        return 0
    fi
    "${cmd[@]}"
    # an `[[ ]] && cmd` tail would return 1 when there is no html pass
    if [[ ${#html_cmd[@]} -gt 0 ]]; then
        "${html_cmd[@]}"
    fi
}

# parse args: stage words, document paths, or mvn pass-through flags
args=()      # stage names to build
files=()     # single documents to build
extra=()     # pass-through mvn flags
for a in "$@"; do
    case "$a" in
        all) args+=(markdown instset asciidoc header asciinema) ;;
        markdown|instset|asciidoc|header|asciinema) args+=("$a") ;;
        -h|--help) usage; exit 0 ;;
        -*) extra+=("$a") ;;
        *.java) args+=(instset) ;;                       # no single-file mode
        *.md|*.adoc) files+=("$a") ;;
        *)
            if [[ -f "$a" ]]; then
                echo "bin/metatron-site: unsupported file type '$a'" >&2
                usage >&2
                exit 2
            fi
            echo "bin/metatron-site: unknown stage '$a'" >&2
            usage >&2
            exit 2
            ;;
    esac
done

[[ ${#args[@]} -gt 0 || ${#files[@]} -gt 0 ]] || { usage; exit 1; }

# file mode first: one file, one runner, no site lifecycle
if [[ ${#files[@]} -gt 0 ]]; then
    for f in "${files[@]}"; do
        [[ -f "$f" ]] || { echo "bin/metatron-site: no such file '$f'" >&2; exit 2; }
        run_file "$f"
    done
fi

# stage mode: only when stages were actually named
[[ ${#args[@]} -gt 0 ]] || exit 0

declare -A skip_flag=(
    [markdown]=-DskipMarkdown
    [instset]=-DskipInstSet
    [asciidoc]=-DskipAsciidoc
    [header]=-DskipHeaderMenu
    [asciinema]=-DskipCasts
)

# build only what was named; wsplus bundling is never a doc stage
skip=(-DskipSiteScripts)
skipped=()
for stage in markdown instset asciidoc header asciinema; do
    if [[ " ${args[*]} " == *" $stage "* ]]; then
        :   # named -> build it
    else
        skip+=("${skip_flag[$stage]}")
        skipped+=("$stage")
    fi
done

echo "==> build: ${args[*]}"
if [[ ${#skipped[@]} -gt 0 ]]; then
    echo "==> skip:  ${skipped[*]} + scripts"
else
    echo "==> skip:  scripts"
fi

cmd=(./mvnw site "${skip[@]}" "${extra[@]}")
echo "==> run:   ${cmd[*]}"
[[ "${DRY_RUN:-0}" = "1" ]] && exit 0
exec "${cmd[@]}"
