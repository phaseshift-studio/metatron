# Local build-server configuration — copy to metatron-remote.env (gitignored).
#
# Every knob here is optional; the defaults live in bin/metatron-remote. Both
# bin/metatron-remote and bin/metatron-docker read this file, so one edit reaches
# every agent session and terminal on this checkout — no shell exports, no recreate.

# Build hosts, in PREFERENCE ORDER (the first host wins a score tie). Entry format is
# whatever ssh accepts: user@host. Add as many as you have.
METATRON_BUILD_HOSTS="killswitch@ginger.local"

# Hard ceiling on concurrent builds per host (0 = unlimited). A soft cap: two agents can
# pass the check in the same second, so the true ceiling is roughly this + 1.
METATRON_MAX_REMOTE_BUILDS=4

# Make plain `bin/metatron-docker build …` delegate to the balancer. Set to 0 to keep
# every build local on this machine.
METATRON_BUILD_REMOTE=1

# Optional: how long to wait for a free slot before giving up (seconds).
# METATRON_MAX_BUILD_WAIT=1800

# Optional: path taken from each host for the synced tree (relative to its $HOME).
# METATRON_BUILD_ROOT=build/metatron
