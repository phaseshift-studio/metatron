## metatron 1.0-alpha ##################################
# @author Marko A. Rodriguez <http://markorodriguez.com>
#
# created for JLine nano syntax highlighter
#  only color, icolor, and syntax commands supported
#  design principle: 
#   highlight as a single uri and then convert sub components into more refined obj highlights
#   necessary as a uri is any parse that isn't some other obj type

syntax "mtron" ".*\.(mtron)$"

# assume everything is a uri
color blue ".*"
### qs
color yellow "\?"
color yellow "&"
# f (j,m,?)
color yellow "\{.\}"
color red "\{\?\}"
### int
color yellow "(0)|(-?[1-9][0-9]*)"
# common sugars
color green "[.:;,+|=!\%@]" "<<" ">>" "<=" "=>" "->" ">-" "-<"
color yellow "[*]"
### real
icolor yellow "(([1-9][0-9]+)|0+)\.[0-9]+(E[-+]?[0-9]+)?"
# common structural tokens
color green "\[" "\]" "\(" "\)" "\{" "\}"
# real exponent
icolor yellow "(\.|[0-9])+E[-+]?[0-9]+"
# uri slash or schema
icolor blue "(/|([a-z]+(://))|[a-z])([0-9]|[a-z]|\.|-|_)+(:)?[0-9]*(/)?([a-z]|/|\_|[0-9])*"
# rec/rel uri key — applied after generic <> coloring below
color green "=>"
### bytes
icolor yellow "0x([0-9]|[A-F]|[a-f])+"
color yellow,underline "0x"
### bool
color yellow "(true)|(false)"
### type
color magenta "::T"
# qProc keys
icolor cyan "(|#|\+|[a-z]|-|_|\{.\})+(=|<=)(?!>)"
icolor blue "=([a-z]|[0-9]|\.|_|-|/|#|\+)+"
icolor cyan "(<=)([a-z]|[0-9]|\.|_|-|/|#|\+)+"
icolor blue "([a-z]|[0-9]|/|#|\+)+::"
color green "=" "::"
# c coefficients
color yellow "\{.{1}\}" "\{[0-9]*,?[0-9]*\}"
### fail
color cyan "\\_[a-z|A-Z]+"
color red "=X"
color yellow "\.\.\."
color green "==>"
color yellow "/=>"
color red "X=>"
### auto resolve
color yellow "!\*" "!" "\^\*" 
### "\{<j>\}"
color green "\{|\}"
color green "\{\}"
###  uri
color blue "[^-][<][^=]([^>])*[>][^-]^(=>)]"
icolor blue "[,a-z0-9_/-]+::"
color green "::" 
### uri <>
color blue "[<][^>]*[>]"
color green "<" ">"
### uri key — overrides generic <> cyan before =>
icolor cyan "</?(<|>|[a-z]|[0-9]|/|_|-|:|\+|#|\.|\s)*>\s*=>"
icolor cyan "/?(<|>|\+|#|[a-z]|[0-9]|/|_|-|:|\.)*\s*=>"
color yellow "\$\{[^}]*\}" "<="
### str
color yellow "[\"][^\"]*[\"]"
color yellow "['][^']*[']"
color yellow start="\"\"\"" end="\"\"\""
color gray "<[^>]>"
### fail
color red "([a-z]|[0-9]|/)*fail::"
### sugars and structures
color magenta "=>" ">-" "-<" "==" "_/" "\\_"
color green "\(" "\)" "\[" "\]" ","
### noobj 
color magenta "noobj"
### @vid
color yellow "@<(/|[a-zA-Z0-9]|\.| |:|-|_|\?)+>" "@(/|[a-zA-Z0-9]|:|-|_|\?)+"
### comments
color gray start="\[--" end="--]"
color gray start="\[==" end="==]"

